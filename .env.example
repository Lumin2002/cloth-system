DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# DJANGO_PORT=8000
# DJANGO_WORKERS=2

# 非必填，不配置时首次启动自动创建管理员账号
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_PASSWORD=
# DJANGO_SUPERUSER_EMAIL=

# 会话超时（分钟）：供应商 / 超管账号空闲超时后需重新登录（当前功能已注释停用，重新启用后生效）
# SUPPLIER_SESSION_IDLE_TIMEOUT_MINUTES=30
# SUPERUSER_SESSION_IDLE_TIMEOUT_MINUTES=15
# SESSION_TIMEOUT_WARNING_SECONDS=60

# Nginx 健康探测地址（生产使用 FRP 公网地址；本地可改成 http://127.0.0.1:8233/）
NGINX_CHECK_URL=https://your-nginx.example.com:40614

# 数据库密码（Docker Compose 部署时必填）
MYSQL_ROOT_PASSWORD=change-me

# CSRF 信任来源（生产环境填公网域名）
CSRF_TRUSTED_ORIGINS=https://your-nginx.example.com:40614

